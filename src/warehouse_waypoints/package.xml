  <version>0.0.1</version>
  <description>Autonomous warehouse waypoint mission with RViz markers</description>
  <maintainer email="todo@todo.todo">toqa</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
